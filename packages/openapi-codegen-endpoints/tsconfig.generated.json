{
  "extends": "./node_modules/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "composite": true,
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "target": "ESNext"
  },
  "include": ["tmp"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src"]
}
