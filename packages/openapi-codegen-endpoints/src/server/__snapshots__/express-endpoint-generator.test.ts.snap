  "import { Schemas } from "./zod.js";
import { Express } from "express";
import { ApiConfig, Operation, CreateInputValidator, CreateController, withDefaults } from "./ExpressZodCommon.js";

type TEndpoints = typeof Schemas.Endpoints;

/** Schema validation from the OpenApi specification. Can be overwritten using ApiConfig. */
const GeneratorDefaultConfig = {
    getPet: {
        requestValidation: {
            headers: Schemas.Endpoints.getPet.params.header,
            query: Schemas.Endpoints.getPet.params.query,
            params: Schemas.Endpoints.getPet.params.path,
            body: Schemas.Endpoints.getPet.request
        },
        responseValidation: Schemas.Endpoints.getPet.responses
    }, updatePet: {
        requestValidation: {
            headers: Schemas.Endpoints.updatePet.params.header,
            query: Schemas.Endpoints.updatePet.params.query,
            params: Schemas.Endpoints.updatePet.params.path,
            body: Schemas.Endpoints.updatePet.request
        },
        responseValidation: Schemas.Endpoints.updatePet.responses
    }, createPet: {
        requestValidation: {
            headers: Schemas.Endpoints.createPet.params.header,
            query: Schemas.Endpoints.createPet.params.query,
            params: Schemas.Endpoints.createPet.params.path,
            body: Schemas.Endpoints.createPet.request
        },
        responseValidation: Schemas.Endpoints.createPet.responses
    }
};
/** All typed operations from OpenApi specification. Operation names are taken from operationId. */
export interface TestApiExpressJsOperations {
    getPet: Operation<TEndpoints["getPet"]["responses"], TEndpoints["getPet"]["request"], TEndpoints["getPet"]["params"]["path"], TEndpoints["getPet"]["params"]["query"], TEndpoints["getPet"]["params"]["header"]>
    updatePet: Operation<TEndpoints["updatePet"]["responses"], TEndpoints["updatePet"]["request"], TEndpoints["updatePet"]["params"]["path"], TEndpoints["updatePet"]["params"]["query"], TEndpoints["updatePet"]["params"]["header"]>
    createPet: Operation<TEndpoints["createPet"]["responses"], TEndpoints["createPet"]["request"], TEndpoints["createPet"]["params"]["path"], TEndpoints["createPet"]["params"]["query"], TEndpoints["createPet"]["params"]["header"]>
}
export interface TestApiExpressJsApiConfig extends ApiConfig<TestApiExpressJsOperations> {
    operations: TestApiExpressJsOperations
}
/**
 * Main function to register all express routes from OpenApi specification. 
 * ApiConfig needs to be implemented. By default request and response validation is generated.
 * To opt-out from default request or schema validation, respective defaults can be set to false 
 * on scopedGlobalConfig or operation level.
 */
export function createTestApiExpressJs(app: Express, apiConfig: TestApiExpressJsApiConfig) {

    const withDefaults_getPet = withDefaults("getPet", apiConfig.operations["getPet"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["get"](
        "/pets/:petId",
        ...(withDefaults_getPet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getPet?.requestValidation?.headers,
            params: withDefaults_getPet?.requestValidation?.params,
            body: withDefaults_getPet?.requestValidation?.body
        }),
        CreateController(withDefaults_getPet.controller as never, withDefaults_getPet?.responseValidation?.responses),
        ...(withDefaults_getPet?.responseMiddlewares ?? [])
    );


    const withDefaults_updatePet = withDefaults("updatePet", apiConfig.operations["updatePet"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["put"](
        "/pets/:petId",
        ...(withDefaults_updatePet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_updatePet?.requestValidation?.headers,
            params: withDefaults_updatePet?.requestValidation?.params,
            body: withDefaults_updatePet?.requestValidation?.body
        }),
        CreateController(withDefaults_updatePet.controller as never, withDefaults_updatePet?.responseValidation?.responses),
        ...(withDefaults_updatePet?.responseMiddlewares ?? [])
    );


    const withDefaults_createPet = withDefaults("createPet", apiConfig.operations["createPet"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["post"](
        "/pets",
        ...(withDefaults_createPet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_createPet?.requestValidation?.headers,
            params: withDefaults_createPet?.requestValidation?.params,
            body: withDefaults_createPet?.requestValidation?.body
        }),
        CreateController(withDefaults_createPet.controller as never, withDefaults_createPet?.responseValidation?.responses),
        ...(withDefaults_createPet?.responseMiddlewares ?? [])
    );

}
