        }),
        CreateController(withDefaults_getInventories.controller as never, withDefaults_getInventories?.responseValidation?.responses),
        ...(withDefaults_getInventories?.responseMiddlewares ?? [])
    );


    const withDefaults_createInventoryItem = withDefaults("createInventoryItem", apiConfig.operations["createInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["post"](
        "/inventory",
        ...(withDefaults_createInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_createInventoryItem?.requestValidation?.headers,
            params: withDefaults_createInventoryItem?.requestValidation?.params,
            body: withDefaults_createInventoryItem?.requestValidation?.body
        }),
        CreateController(withDefaults_createInventoryItem.controller as never, withDefaults_createInventoryItem?.responseValidation?.responses),
