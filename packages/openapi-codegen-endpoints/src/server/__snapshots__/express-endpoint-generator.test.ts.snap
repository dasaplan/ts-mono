    );


    const withDefaults_changeInventoryItem = withDefaults("changeInventoryItem", apiConfig.operations["changeInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["post"](
        "/inventory/:productId",
        ...(withDefaults_changeInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_changeInventoryItem?.requestValidation?.headers,
            params: withDefaults_changeInventoryItem?.requestValidation?.params,
            body: withDefaults_changeInventoryItem?.requestValidation?.body
        }),
        CreateController(withDefaults_changeInventoryItem.controller as never, withDefaults_changeInventoryItem?.responseValidation?.responses),
        ...(withDefaults_changeInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_getInventorySummary = withDefaults("getInventorySummary", apiConfig.operations["getInventorySummary"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["get"](
        "/inventory/summary",
        ...(withDefaults_getInventorySummary?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getInventorySummary?.requestValidation?.headers,
            params: withDefaults_getInventorySummary?.requestValidation?.params,
            body: withDefaults_getInventorySummary?.requestValidation?.body
        }),
        CreateController(withDefaults_getInventorySummary.controller as never, withDefaults_getInventorySummary?.responseValidation?.responses),
        ...(withDefaults_getInventorySummary?.responseMiddlewares ?? [])
    );


    const withDefaults_login = withDefaults("login", apiConfig.operations["login"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["post"](
        "/login",
        ...(withDefaults_login?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_login?.requestValidation?.headers,
            params: withDefaults_login?.requestValidation?.params,
            body: withDefaults_login?.requestValidation?.body
        }),
        CreateController(withDefaults_login.controller as never, withDefaults_login?.responseValidation?.responses),
        ...(withDefaults_login?.responseMiddlewares ?? [])
    );


    const withDefaults_register = withDefaults("register", apiConfig.operations["register"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["post"](
        "/register",
        ...(withDefaults_register?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_register?.requestValidation?.headers,
            params: withDefaults_register?.requestValidation?.params,
            body: withDefaults_register?.requestValidation?.body
        }),
        CreateController(withDefaults_register.controller as never, withDefaults_register?.responseValidation?.responses),
        ...(withDefaults_register?.responseMiddlewares ?? [])
    );


    const withDefaults_importInventory = withDefaults("importInventory", apiConfig.operations["importInventory"], apiConfig.defaults, GeneratorDefaultConfig);
