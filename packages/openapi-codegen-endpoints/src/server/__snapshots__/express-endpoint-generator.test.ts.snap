    );


    const withDefaults_updateInventoryItem = withDefaults("updateInventoryItem", apiConfig.operations["updateInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig);
    app.router["put"](
        "/inventory/:productId",
        ...(withDefaults_updateInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_updateInventoryItem?.requestValidation?.headers,
            params: withDefaults_updateInventoryItem?.requestValidation?.params,
