{
  "extends": "./node_modules/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
