{
  "name": "@dasaplan/openapi-cli",
  "version": "0.0.0",
  "description": "Unified CLI for OpenAPI code generation tools",
  "keywords": [
    "OpenAPI",
    "CLI",
    "codegen",
    "zod",
    "endpoints",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dasaplan/ts-mono.git",
    "directory": "packages/oa_cli"
  },
  "author": "dsp",
  "type": "module",
  "bin": {
    "oa-cli": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s rup",
    "clean": "rimraf dist",
    "lint": "eslint \"./src/**/*.ts\" 2>/dev/null || true",
    "lint:fix": "eslint \"./src/**/*.ts\" --fix 2>/dev/null || true",
    "prepack": "sort-package-json --quiet && clean-package",
    "pack": "pnpm pack",
    "postpack": "clean-package restore",
    "rup": "tsup-node --dts",
    "ts:build": "tsc -p tsconfig.build.json",
    "ts:check": "tsc"
  },
  "dependencies": {
    "@dasaplan/openapi-bundler": "workspace:*",
    "@dasaplan/openapi-codegen-ts": "workspace:*",
    "@dasaplan/ts-sdk": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@dasaplan/dev-tools": "workspace:*",
    "tsconfig": "workspace:*"
  },
  "clean-package": {
    "remove": [
      "scripts.build",
      "scripts.clean",
      "scripts.ts:build",
      "scripts.ts:check",
      "scripts.lint",
      "scripts.lint:fix",
      "scripts.prepack",
      "scripts.pack",
      "scripts.postpack",
      "devDependencies",
      "tsup"
    ]
  },
  "tsup": {
    "entry": [
      "src/cli.ts",
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "tsconfig.build.json",
    "clean": true,
    "sourcemap": true,
    "outDir": "dist",
    "shims": true
  }
}
