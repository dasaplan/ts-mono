{
  "name": "@dasaplan/openapi-tolerant-reader",
  "version": "0.2.5",
  "description": "Openapi solutions to support tolerant reader.",
  "keywords": [
    "openapi",
    "typescript",
    "ts",
    "zod",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dasaplan/ts-mono.git",
    "directory": "packages/openapi-tolerant-reader"
  },
  "author": "dsp",
  "type": "module",
  "exports": {
    "./dist/templates/*": "./templates/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "run-s rup",
    "clean": "rimraf dist out tmp",
    "lint": "eslint \"./src/*.ts\" index.ts",
    "lint:fix": "eslint \"./src/*.ts\" index.ts --fix",
    "prepack": "sort-package-json --quiet && clean-package",
    "pack": "pnpm pack",
    "postpack": "clean-package restore",
    "rup": "tsup-node --dts",
    "test": "vitest",
    "test:it": "echo vitest --project integration-test",
    "test:unit": "vitest --project unit-test",
    "test:update": "vitest -u",
    "ts:build": "tsc -p tsconfig.build.json",
    "ts:check": "tsc"
  },
  "devDependencies": {
    "@dasaplan/dev-tools": "workspace:*",
    "clean-package": "^2.2.0",
    "npm-run-all": "^4.1.5",
    "sort-package-json": "^3.6.1",
    "tsconfig": "workspace:*"
  },
  "clean-package": {
    "remove": [
      "scripts.build",
      "scripts.clean",
      "scripts.lint",
      "scripts.lint:fix",
      "scripts.lint:prepack",
      "scripts.lint:rup",
      "scripts.lint:test",
      "scripts.lint:test:it",
      "scripts.lint:test:unit",
      "scripts.lint:test:update",
      "devDependencies",
      "tsup",
      "clean-package",
      "dependencies.@dasaplan/ts-sdk"
    ]
  },
  "tsup": {
    "entry": [
      "index.ts"
    ],
    "noExternal": [
      "@dasaplan/ts-sdk",
      "tsconfig"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "tsconfig": "tsconfig.build.json",
    "clean": true,
    "sourcemap": true
  }
}
