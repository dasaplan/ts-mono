        ...(withDefaults_createInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_updateInventoryItem = withDefaults("updateInventoryItem", apiConfig.operations["updateInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["updateInventoryItem"]);
    app.router["put"](
        "/inventory/:productId",
        ...(withDefaults_updateInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.headers : undefined,
            params: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.params : undefined,
            body: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.body : undefined
        }),
        CreateController(withDefaults_updateInventoryItem.controller, withDefaults_updateInventoryItem?.responseValidation ? withDefaults_updateInventoryItem.responseValidation.responses : undefined),
        ...(withDefaults_updateInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_changeInventoryItem = withDefaults("changeInventoryItem", apiConfig.operations["changeInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["changeInventoryItem"]);
    app.router["post"](
        "/inventory/:productId",
        ...(withDefaults_changeInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.headers : undefined,
            params: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.params : undefined,
            body: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.body : undefined
        }),
        CreateController(withDefaults_changeInventoryItem.controller, withDefaults_changeInventoryItem?.responseValidation ? withDefaults_changeInventoryItem.responseValidation.responses : undefined),
        ...(withDefaults_changeInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_getInventorySummary = withDefaults("getInventorySummary", apiConfig.operations["getInventorySummary"], apiConfig.defaults, GeneratorDefaultConfig["getInventorySummary"]);
    app.router["get"](
        "/inventory/summary",
        ...(withDefaults_getInventorySummary?.requestMiddlewares ?? []),
        CreateInputValidator({
