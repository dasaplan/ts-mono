        ...(withDefaults_getInventorySummary?.responseMiddlewares ?? [])
    );


    const withDefaults_login = withDefaults("login", apiConfig.operations["login"], apiConfig.defaults, GeneratorDefaultConfig["login"]);
    app.router["post"](
        "/login",
        ...(withDefaults_login?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.headers : undefined,
            params: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.params : undefined,
            body: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.body : undefined
        }),
        CreateController(withDefaults_login.controller, withDefaults_login?.responseValidation ? withDefaults_login.responseValidation.responses : undefined),
        ...(withDefaults_login?.responseMiddlewares ?? [])
    );


    const withDefaults_register = withDefaults("register", apiConfig.operations["register"], apiConfig.defaults, GeneratorDefaultConfig["register"]);
    app.router["post"](
        "/register",
        ...(withDefaults_register?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.headers : undefined,
            params: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.params : undefined,
            body: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.body : undefined
        }),
        CreateController(withDefaults_register.controller, withDefaults_register?.responseValidation ? withDefaults_register.responseValidation.responses : undefined),
        ...(withDefaults_register?.responseMiddlewares ?? [])
    );


    const withDefaults_importInventory = withDefaults("importInventory", apiConfig.operations["importInventory"], apiConfig.defaults, GeneratorDefaultConfig["importInventory"]);
    app.router["post"](
        "/import/inventory",
        ...(withDefaults_importInventory?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.headers : undefined,
            params: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.params : undefined,
            body: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.body : undefined
        }),
        CreateController(withDefaults_importInventory.controller, withDefaults_importInventory?.responseValidation ? withDefaults_importInventory.responseValidation.responses : undefined),
        ...(withDefaults_importInventory?.responseMiddlewares ?? [])
    );


    const withDefaults_saveInventory = withDefaults("saveInventory", apiConfig.operations["saveInventory"], apiConfig.defaults, GeneratorDefaultConfig["saveInventory"]);
    app.router["post"](
        "/save/inventory",
        ...(withDefaults_saveInventory?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_saveInventory?.requestValidation ? withDefaults_saveInventory.requestValidation.headers : undefined,
            params: withDefaults_saveInventory?.requestValidation ? withDefaults_saveInventory.requestValidation.params : undefined,
            body: withDefaults_saveInventory?.requestValidation ? withDefaults_saveInventory.requestValidation.body : undefined
        }),
        CreateController(withDefaults_saveInventory.controller, withDefaults_saveInventory?.responseValidation ? withDefaults_saveInventory.responseValidation.responses : undefined),
        ...(withDefaults_saveInventory?.responseMiddlewares ?? [])
    );

}
