        ...(withDefaults_updatePet?.responseMiddlewares ?? [])
    );


    const withDefaults_createPet = withDefaults("createPet", apiConfig.operations["createPet"], apiConfig.defaults, GeneratorDefaultConfig["createPet"]);
    app.router["post"](
        "/pets",
        ...(withDefaults_createPet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_createPet?.requestValidation ? withDefaults_createPet.requestValidation.headers : undefined,
            params: withDefaults_createPet?.requestValidation ? withDefaults_createPet.requestValidation.params : undefined,
            body: withDefaults_createPet?.requestValidation ? withDefaults_createPet.requestValidation.body : undefined
        }),
        CreateController(withDefaults_createPet.controller, withDefaults_createPet?.responseValidation ? withDefaults_createPet.responseValidation.responses : undefined),
        ...(withDefaults_createPet?.responseMiddlewares ?? [])
    );

}
