        ...(withDefaults_getInventories?.responseMiddlewares ?? [])
    );


    const withDefaults_createInventoryItem = withDefaults("createInventoryItem", apiConfig.operations["createInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["createInventoryItem"]);
    app.router["post"](
        "/inventory",
        ...(withDefaults_createInventoryItem?.requestMiddlewares ?? []),
