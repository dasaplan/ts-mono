            params: Schemas.Endpoints.getInventories.params.path,
            body: Schemas.Endpoints.getInventories.request
        },
        responseValidation: { responses: Schemas.Endpoints.getInventories.responses }
    }, createInventoryItem: {
        requestValidation: {
            headers: Schemas.Endpoints.createInventoryItem.params.header,
            query: Schemas.Endpoints.createInventoryItem.params.query,
            params: Schemas.Endpoints.createInventoryItem.params.path,
            body: Schemas.Endpoints.createInventoryItem.request
        },
        responseValidation: { responses: Schemas.Endpoints.createInventoryItem.responses }
    }, updateInventoryItem: {
        requestValidation: {
            headers: Schemas.Endpoints.updateInventoryItem.params.header,
            query: Schemas.Endpoints.updateInventoryItem.params.query,
            params: Schemas.Endpoints.updateInventoryItem.params.path,
            body: Schemas.Endpoints.updateInventoryItem.request
        },
        responseValidation: { responses: Schemas.Endpoints.updateInventoryItem.responses }
    }, changeInventoryItem: {
        requestValidation: {
            headers: Schemas.Endpoints.changeInventoryItem.params.header,
            query: Schemas.Endpoints.changeInventoryItem.params.query,
            params: Schemas.Endpoints.changeInventoryItem.params.path,
            body: Schemas.Endpoints.changeInventoryItem.request
        },
        responseValidation: { responses: Schemas.Endpoints.changeInventoryItem.responses }
    }, getInventorySummary: {
        requestValidation: {
            headers: Schemas.Endpoints.getInventorySummary.params.header,
            query: Schemas.Endpoints.getInventorySummary.params.query,
            params: Schemas.Endpoints.getInventorySummary.params.path,
            body: Schemas.Endpoints.getInventorySummary.request
        },
        responseValidation: { responses: Schemas.Endpoints.getInventorySummary.responses }
    }, login: {
        requestValidation: {
            headers: Schemas.Endpoints.login.params.header,
            query: Schemas.Endpoints.login.params.query,
            params: Schemas.Endpoints.login.params.path,
            body: Schemas.Endpoints.login.request
        },
        responseValidation: { responses: Schemas.Endpoints.login.responses }
    }, register: {
        requestValidation: {
            headers: Schemas.Endpoints.register.params.header,
            query: Schemas.Endpoints.register.params.query,
            params: Schemas.Endpoints.register.params.path,
            body: Schemas.Endpoints.register.request
        },
        responseValidation: { responses: Schemas.Endpoints.register.responses }
    }, importInventory: {
        requestValidation: {
            headers: Schemas.Endpoints.importInventory.params.header,
            query: Schemas.Endpoints.importInventory.params.query,
            params: Schemas.Endpoints.importInventory.params.path,
            body: Schemas.Endpoints.importInventory.request
        },
        responseValidation: { responses: Schemas.Endpoints.importInventory.responses }
    }, saveInventory: {
        requestValidation: {
            headers: Schemas.Endpoints.saveInventory.params.header,
            query: Schemas.Endpoints.saveInventory.params.query,
            params: Schemas.Endpoints.saveInventory.params.path,
            body: Schemas.Endpoints.saveInventory.request
        },
        responseValidation: { responses: Schemas.Endpoints.saveInventory.responses }
    }
};
/** All typed operations from OpenApi specification. Operation names are taken from operationId. */
export interface FullmetalApiExpressJsOperations {
    getConstants: Operation<TEndpoints["getConstants"]["responses"], TEndpoints["getConstants"]["request"], TEndpoints["getConstants"]["params"]["path"], TEndpoints["getConstants"]["params"]["query"], TEndpoints["getConstants"]["params"]["header"]>
    upsertConstant: Operation<TEndpoints["upsertConstant"]["responses"], TEndpoints["upsertConstant"]["request"], TEndpoints["upsertConstant"]["params"]["path"], TEndpoints["upsertConstant"]["params"]["query"], TEndpoints["upsertConstant"]["params"]["header"]>
    getInventories: Operation<TEndpoints["getInventories"]["responses"], TEndpoints["getInventories"]["request"], TEndpoints["getInventories"]["params"]["path"], TEndpoints["getInventories"]["params"]["query"], TEndpoints["getInventories"]["params"]["header"]>
    createInventoryItem: Operation<TEndpoints["createInventoryItem"]["responses"], TEndpoints["createInventoryItem"]["request"], TEndpoints["createInventoryItem"]["params"]["path"], TEndpoints["createInventoryItem"]["params"]["query"], TEndpoints["createInventoryItem"]["params"]["header"]>
    updateInventoryItem: Operation<TEndpoints["updateInventoryItem"]["responses"], TEndpoints["updateInventoryItem"]["request"], TEndpoints["updateInventoryItem"]["params"]["path"], TEndpoints["updateInventoryItem"]["params"]["query"], TEndpoints["updateInventoryItem"]["params"]["header"]>
    changeInventoryItem: Operation<TEndpoints["changeInventoryItem"]["responses"], TEndpoints["changeInventoryItem"]["request"], TEndpoints["changeInventoryItem"]["params"]["path"], TEndpoints["changeInventoryItem"]["params"]["query"], TEndpoints["changeInventoryItem"]["params"]["header"]>
    getInventorySummary: Operation<TEndpoints["getInventorySummary"]["responses"], TEndpoints["getInventorySummary"]["request"], TEndpoints["getInventorySummary"]["params"]["path"], TEndpoints["getInventorySummary"]["params"]["query"], TEndpoints["getInventorySummary"]["params"]["header"]>
    login: Operation<TEndpoints["login"]["responses"], TEndpoints["login"]["request"], TEndpoints["login"]["params"]["path"], TEndpoints["login"]["params"]["query"], TEndpoints["login"]["params"]["header"]>
    register: Operation<TEndpoints["register"]["responses"], TEndpoints["register"]["request"], TEndpoints["register"]["params"]["path"], TEndpoints["register"]["params"]["query"], TEndpoints["register"]["params"]["header"]>
    importInventory: Operation<TEndpoints["importInventory"]["responses"], TEndpoints["importInventory"]["request"], TEndpoints["importInventory"]["params"]["path"], TEndpoints["importInventory"]["params"]["query"], TEndpoints["importInventory"]["params"]["header"]>
    saveInventory: Operation<TEndpoints["saveInventory"]["responses"], TEndpoints["saveInventory"]["request"], TEndpoints["saveInventory"]["params"]["path"], TEndpoints["saveInventory"]["params"]["query"], TEndpoints["saveInventory"]["params"]["header"]>
}
export interface FullmetalApiExpressJsApiConfig extends ApiConfig<FullmetalApiExpressJsOperations> {
    operations: FullmetalApiExpressJsOperations
}
/**
 * Main function to register all express routes from OpenApi specification. 
 * ApiConfig needs to be implemented. By default request and response validation is generated.
 * To opt-out from default request or schema validation, respective defaults can be set to false 
 * on scopedGlobalConfig or operation level.
 */
export function createFullmetalApiExpressJs(app: Express, apiConfig: FullmetalApiExpressJsApiConfig) {

    const withDefaults_getConstants = withDefaults("getConstants", apiConfig.operations["getConstants"], apiConfig.defaults, GeneratorDefaultConfig["getConstants"]);
    app.router["get"](
        "/constants",
        ...(withDefaults_getConstants?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.headers : undefined,
            params: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.params : undefined,
            body: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.body : undefined
        }),
        CreateController(withDefaults_getConstants.controller, withDefaults_getConstants?.responseValidation ? withDefaults_getConstants.responseValidation.responses : undefined),
        ...(withDefaults_getConstants?.responseMiddlewares ?? [])
    );


    const withDefaults_upsertConstant = withDefaults("upsertConstant", apiConfig.operations["upsertConstant"], apiConfig.defaults, GeneratorDefaultConfig["upsertConstant"]);
    app.router["post"](
        "/constants",
        ...(withDefaults_upsertConstant?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_upsertConstant?.requestValidation ? withDefaults_upsertConstant.requestValidation.headers : undefined,
            params: withDefaults_upsertConstant?.requestValidation ? withDefaults_upsertConstant.requestValidation.params : undefined,
            body: withDefaults_upsertConstant?.requestValidation ? withDefaults_upsertConstant.requestValidation.body : undefined
        }),
        CreateController(withDefaults_upsertConstant.controller, withDefaults_upsertConstant?.responseValidation ? withDefaults_upsertConstant.responseValidation.responses : undefined),
        ...(withDefaults_upsertConstant?.responseMiddlewares ?? [])
    );


    const withDefaults_getInventories = withDefaults("getInventories", apiConfig.operations["getInventories"], apiConfig.defaults, GeneratorDefaultConfig["getInventories"]);
    app.router["get"](
        "/inventory",
        ...(withDefaults_getInventories?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getInventories?.requestValidation ? withDefaults_getInventories.requestValidation.headers : undefined,
            params: withDefaults_getInventories?.requestValidation ? withDefaults_getInventories.requestValidation.params : undefined,
            body: withDefaults_getInventories?.requestValidation ? withDefaults_getInventories.requestValidation.body : undefined
        }),
        CreateController(withDefaults_getInventories.controller, withDefaults_getInventories?.responseValidation ? withDefaults_getInventories.responseValidation.responses : undefined),
        ...(withDefaults_getInventories?.responseMiddlewares ?? [])
    );


    const withDefaults_createInventoryItem = withDefaults("createInventoryItem", apiConfig.operations["createInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["createInventoryItem"]);
    app.router["post"](
        "/inventory",
        ...(withDefaults_createInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_createInventoryItem?.requestValidation ? withDefaults_createInventoryItem.requestValidation.headers : undefined,
            params: withDefaults_createInventoryItem?.requestValidation ? withDefaults_createInventoryItem.requestValidation.params : undefined,
            body: withDefaults_createInventoryItem?.requestValidation ? withDefaults_createInventoryItem.requestValidation.body : undefined
        }),
        CreateController(withDefaults_createInventoryItem.controller, withDefaults_createInventoryItem?.responseValidation ? withDefaults_createInventoryItem.responseValidation.responses : undefined),
        ...(withDefaults_createInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_updateInventoryItem = withDefaults("updateInventoryItem", apiConfig.operations["updateInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["updateInventoryItem"]);
    app.router["put"](
        "/inventory/:productId",
        ...(withDefaults_updateInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.headers : undefined,
            params: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.params : undefined,
            body: withDefaults_updateInventoryItem?.requestValidation ? withDefaults_updateInventoryItem.requestValidation.body : undefined
        }),
        CreateController(withDefaults_updateInventoryItem.controller, withDefaults_updateInventoryItem?.responseValidation ? withDefaults_updateInventoryItem.responseValidation.responses : undefined),
        ...(withDefaults_updateInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_changeInventoryItem = withDefaults("changeInventoryItem", apiConfig.operations["changeInventoryItem"], apiConfig.defaults, GeneratorDefaultConfig["changeInventoryItem"]);
    app.router["post"](
        "/inventory/:productId",
        ...(withDefaults_changeInventoryItem?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.headers : undefined,
            params: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.params : undefined,
            body: withDefaults_changeInventoryItem?.requestValidation ? withDefaults_changeInventoryItem.requestValidation.body : undefined
        }),
        CreateController(withDefaults_changeInventoryItem.controller, withDefaults_changeInventoryItem?.responseValidation ? withDefaults_changeInventoryItem.responseValidation.responses : undefined),
        ...(withDefaults_changeInventoryItem?.responseMiddlewares ?? [])
    );


    const withDefaults_getInventorySummary = withDefaults("getInventorySummary", apiConfig.operations["getInventorySummary"], apiConfig.defaults, GeneratorDefaultConfig["getInventorySummary"]);
    app.router["get"](
        "/inventory/summary",
        ...(withDefaults_getInventorySummary?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getInventorySummary?.requestValidation ? withDefaults_getInventorySummary.requestValidation.headers : undefined,
            params: withDefaults_getInventorySummary?.requestValidation ? withDefaults_getInventorySummary.requestValidation.params : undefined,
            body: withDefaults_getInventorySummary?.requestValidation ? withDefaults_getInventorySummary.requestValidation.body : undefined
        }),
        CreateController(withDefaults_getInventorySummary.controller, withDefaults_getInventorySummary?.responseValidation ? withDefaults_getInventorySummary.responseValidation.responses : undefined),
        ...(withDefaults_getInventorySummary?.responseMiddlewares ?? [])
    );


    const withDefaults_login = withDefaults("login", apiConfig.operations["login"], apiConfig.defaults, GeneratorDefaultConfig["login"]);
    app.router["post"](
        "/login",
        ...(withDefaults_login?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.headers : undefined,
            params: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.params : undefined,
            body: withDefaults_login?.requestValidation ? withDefaults_login.requestValidation.body : undefined
        }),
        CreateController(withDefaults_login.controller, withDefaults_login?.responseValidation ? withDefaults_login.responseValidation.responses : undefined),
        ...(withDefaults_login?.responseMiddlewares ?? [])
    );


    const withDefaults_register = withDefaults("register", apiConfig.operations["register"], apiConfig.defaults, GeneratorDefaultConfig["register"]);
    app.router["post"](
        "/register",
        ...(withDefaults_register?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.headers : undefined,
            params: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.params : undefined,
            body: withDefaults_register?.requestValidation ? withDefaults_register.requestValidation.body : undefined
        }),
        CreateController(withDefaults_register.controller, withDefaults_register?.responseValidation ? withDefaults_register.responseValidation.responses : undefined),
        ...(withDefaults_register?.responseMiddlewares ?? [])
    );


    const withDefaults_importInventory = withDefaults("importInventory", apiConfig.operations["importInventory"], apiConfig.defaults, GeneratorDefaultConfig["importInventory"]);
    app.router["post"](
        "/import/inventory",
        ...(withDefaults_importInventory?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.headers : undefined,
            params: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.params : undefined,
            body: withDefaults_importInventory?.requestValidation ? withDefaults_importInventory.requestValidation.body : undefined
        }),
