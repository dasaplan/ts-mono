 * ApiConfig needs to be implemented. By default request and response validation is generated.
 * To opt-out from default request or schema validation, respective defaults can be set to false 
 * on scopedGlobalConfig or operation level.
 */
export function createTestApiExpressJs(app: Express, apiConfig: TestApiExpressJsApiConfig) {

    const withDefaults_getPet = withDefaults("getPet", apiConfig.operations["getPet"], apiConfig.defaults, GeneratorDefaultConfig["getPet"]);
    app.router["get"](
        "/pets/:petId",
        ...(withDefaults_getPet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getPet?.requestValidation ? withDefaults_getPet.requestValidation.headers : undefined,
            params: withDefaults_getPet?.requestValidation ? withDefaults_getPet.requestValidation.params : undefined,
            body: withDefaults_getPet?.requestValidation ? withDefaults_getPet.requestValidation.body : undefined
        }),
        CreateController(withDefaults_getPet.controller, withDefaults_getPet?.responseValidation ? withDefaults_getPet.responseValidation.responses : undefined),
        ...(withDefaults_getPet?.responseMiddlewares ?? [])
    );


    const withDefaults_updatePet = withDefaults("updatePet", apiConfig.operations["updatePet"], apiConfig.defaults, GeneratorDefaultConfig["updatePet"]);
    app.router["put"](
        "/pets/:petId",
        ...(withDefaults_updatePet?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_updatePet?.requestValidation ? withDefaults_updatePet.requestValidation.headers : undefined,
            params: withDefaults_updatePet?.requestValidation ? withDefaults_updatePet.requestValidation.params : undefined,
            body: withDefaults_updatePet?.requestValidation ? withDefaults_updatePet.requestValidation.body : undefined
        }),
