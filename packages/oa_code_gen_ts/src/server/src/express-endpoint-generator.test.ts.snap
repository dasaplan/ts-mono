/**
 * Main function to register all express routes from OpenApi specification. 
 * ApiConfig needs to be implemented. By default request and response validation is generated.
 * To opt-out from default request or schema validation, respective defaults can be set to false 
 * on scopedGlobalConfig or operation level.
 */
export function createFullmetalApiExpressJs(app: Express, apiConfig: FullmetalApiExpressJsApiConfig) {

    const withDefaults_getConstants = withDefaults("getConstants", apiConfig.operations["getConstants"], apiConfig.defaults, GeneratorDefaultConfig["getConstants"]);
    app.router["get"](
        "/constants",
        ...(withDefaults_getConstants?.requestMiddlewares ?? []),
        CreateInputValidator({
            headers: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.headers : undefined,
            params: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.params : undefined,
            body: withDefaults_getConstants?.requestValidation ? withDefaults_getConstants.requestValidation.body : undefined
        }),
        CreateController(withDefaults_getConstants.controller, withDefaults_getConstants?.responseValidation ? withDefaults_getConstants.responseValidation.responses : undefined),
        ...(withDefaults_getConstants?.responseMiddlewares ?? [])
