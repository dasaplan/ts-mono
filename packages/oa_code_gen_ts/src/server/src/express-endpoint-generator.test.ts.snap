            headers: Schemas.Endpoints.createPet.params.header,
            query: Schemas.Endpoints.createPet.params.query,
            params: Schemas.Endpoints.createPet.params.path,
            body: Schemas.Endpoints.createPet.request
        },
        responseValidation: { responses: Schemas.Endpoints.createPet.responses }
