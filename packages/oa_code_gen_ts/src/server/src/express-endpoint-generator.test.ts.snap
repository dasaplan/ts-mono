    export const ResponseSchema = z.object({ id: z.string().or(z.undefined()) });

    export namespace Types {
        export type ErrorSchema = z.infer<typeof Schemas.ErrorSchema>;
        export type RequestSchema = z.infer<typeof Schemas.RequestSchema>;
        export type ResponseSchema = z.infer<typeof Schemas.ResponseSchema>;
