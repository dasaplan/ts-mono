{
  "extends": "./node_modules/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true
  },
  "include": ["index.ts", "src/server", "src/model", "src/marshalling", "src/client"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
